    "chunks": [
      {
        "chunkId": "chunk_gm_001a",
        "transmissionId": "tx_good_morning",
        "lineId": "line_001",
        "startMs": 0,
        "endMs": 6200,
        "speakerLabel": "SYSTEM",
        "text": "グッド・モーニング, MAGNOLIA.\n動作確認を開始します"
      },
      {
        "chunkId": "chunk_gm_002a",
        "transmissionId": "tx_good_morning",
        "lineId": "line_002",
        "startMs": 6600,
        "endMs": 15000,
        "speakerLabel": "SYSTEM",
        "text": "左クリックでmain攻撃,\n右クリックでsub（バリア）を利用できます\n被弾すると通信状況が悪化します"
      },
      {
        "chunkId": "chunk_gm_003a",
        "transmissionId": "tx_good_morning",
        "lineId": "line_003",
        "startMs": 15400,
        "endMs": 21000,
        "speakerLabel": "SYSTEM",
        "text": "敵に近づくとmainは近接攻撃を発動します"
      },
      {
        "chunkId": "chunk_gm_005a",
        "transmissionId": "tx_good_morning",
        "lineId": "line_005",
        "startMs": 21400,
        "endMs": 28500,
        "speakerLabel": "SYSTEM",
        "text": "赤色は災害警告です.\n回避するか, 防御装備を利用してください."
      },
      {
        "chunkId": "chunk_gm_006a",
        "transmissionId": "tx_good_morning",
        "lineId": "line_006",
        "startMs": 29100,
        "endMs": 37200,
        "speakerLabel": "SYSTEM",
        "text": "動作確認は以上になります.\nos: magnoliaを装備して通信の回復に向かってください.\n幸運を"
      }
    ]
