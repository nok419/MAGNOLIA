  "transmission": {
    "transmissionId": "tx_good_morning",
    "title": "グッド・モーニング",
    "sender": "MAGNOLIA",
    "transcriptChunkIds": [
      "chunk_gm_001a",
      "chunk_gm_001b",
      "chunk_gm_001c",
      "chunk_gm_002a",
      "chunk_gm_002b",
