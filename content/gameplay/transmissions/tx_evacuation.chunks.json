    "lineId": "evacuation_line_01",
    "startMs": 2800,
    "endMs": 4000,
    "speakerLabel": "CIVIL-DEFENSE",
    "text": "全市民は直ちに地下シェルターへ避難してください。"
  },
  {
    "chunkId": "tx_evacuation_02a",
    "transmissionId": "tx_evacuation",
    "lineId": "evacuation_line_02",
    "startMs": 4500,
    "endMs": 6000,
    "speakerLabel": "CIVIL-DEFENSE",
    "text": "繰り返します……市民の皆さんは直ちに避難を……。"
  },
  {
    "chunkId": "tx_evacuation_02b",
    "transmissionId": "tx_evacuation",
    "lineId": "evacuation_line_02",
    "startMs": 6000,
    "endMs": 7200,
    "speakerLabel": "CIVIL-DEFENSE",
