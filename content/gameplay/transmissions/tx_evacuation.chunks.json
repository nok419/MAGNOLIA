    "lineId": "evacuation_line_02",
    "startMs": 7200,
    "endMs": 8500,
    "speakerLabel": "CIVIL-DEFENSE",
    "text": "自力で……"
  },
  {
    "chunkId": "tx_evacuation_03a",
