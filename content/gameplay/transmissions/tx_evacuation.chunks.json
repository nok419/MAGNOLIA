  {
    "chunkId": "tx_evacuation_04b",
    "transmissionId": "tx_evacuation",
    "lineId": "evacuation_line_04",
    "startMs": 18500,
    "endMs": 21000,
    "speakerLabel": "CIVIL-DEFENSE",
    "text": "放送を受信している端末は、この案内を保存してください。"
  },
  {
    "chunkId": "tx_evacuation_05a",
    "transmissionId": "tx_evacuation",
    "lineId": "evacuation_line_05",
    "startMs": 22500,
    "endMs": 25200,
    "speakerLabel": "CIVIL-DEFENSE",
    "text": "避難経路、更新……更新に失敗。前回の経路を参照……"
  },
  {
    "chunkId": "tx_evacuation_05b",
    "transmissionId": "tx_evacuation",
