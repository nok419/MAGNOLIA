[
  {
    "chunkId": "chunk_gm_001a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_001",
    "startMs": 0,
    "endMs": 2200,
    "speakerLabel": "SYSTEM",
    "text": "再起動プロトコルを開始します。"
  },
  {
    "chunkId": "chunk_gm_001b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_001",
    "startMs": 2200,
    "endMs": 3400,
    "speakerLabel": "SYSTEM",
    "text": "……起動確認、正常。"
  },
  {
    "chunkId": "chunk_gm_001c",
    "transmissionId": "tx_good_morning",
    "lineId": "line_001",
    "startMs": 3400,
    "endMs": 5000,
    "speakerLabel": "SYSTEM",
    "text": "ようこそ、MAGNOLIA。"
  },
  {
    "chunkId": "chunk_gm_002a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_002",
    "startMs": 5000,
    "endMs": 6500,
    "speakerLabel": "SYSTEM",
    "text": "おはよう。"
  },
  {
    "chunkId": "chunk_gm_002b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_002",
    "startMs": 6500,
    "endMs": 10000,
    "speakerLabel": "SYSTEM",
    "text": "目が覚めたなら、まずは周りを確認してみてほしい。"
  },
  {
    "chunkId": "chunk_gm_003a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_003",
    "startMs": 10000,
    "endMs": 13500,
    "speakerLabel": "SYSTEM",
    "text": "前方にノイズ源を検出。",
    "importance": "important"
  },
  {
    "chunkId": "chunk_gm_003b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_003",
    "startMs": 13500,
    "endMs": 17000,
    "speakerLabel": "SYSTEM",
    "text": "近づく前にノイズ源を弱め、聴取の余白を確保します。"
  },
  {
    "chunkId": "chunk_gm_004a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_004",
    "startMs": 17000,
    "endMs": 20000,
    "speakerLabel": "SYSTEM",
    "text": "至近距離の乱れには、短い防護波で言葉の欠損を抑えます。"
  },
  {
    "chunkId": "chunk_gm_004b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_004",
    "startMs": 20000,
    "endMs": 23000,
    "speakerLabel": "SYSTEM",
    "text": "距離を詰めてみてくれ。"
  },
  {
    "chunkId": "chunk_gm_005a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_005",
    "startMs": 23000,
    "endMs": 26500,
    "speakerLabel": "SYSTEM",
    "text": "防御機能を確認する。ノイズキャンセラーを展開してみてほしい。"
  },
  {
    "chunkId": "chunk_gm_005b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_005",
    "startMs": 26500,
    "endMs": 30000,
    "speakerLabel": "SYSTEM",
    "text": "可視ノイズを一時的に無効化できます。"
  },
  {
    "chunkId": "chunk_gm_006a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_006",
    "startMs": 30000,
    "endMs": 33500,
    "speakerLabel": "SYSTEM",
    "text": "被弾するとノイズが蓄積する。"
  },
  {
    "chunkId": "chunk_gm_006b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_006",
    "startMs": 33500,
    "endMs": 37000,
    "speakerLabel": "SYSTEM",
    "text": "蓄積が閾値を超えると通信の聴取に支障が出ます。"
  },
  {
    "chunkId": "chunk_gm_007a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_007",
    "startMs": 37000,
    "endMs": 40500,
    "speakerLabel": "SYSTEM",
    "text": "警告域の赤い点滅は磁気災害の予兆です。"
  },
  {
    "chunkId": "chunk_gm_007b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_007",
    "startMs": 40500,
    "endMs": 44000,
    "speakerLabel": "SYSTEM",
    "text": "範囲内ではノイズが継続的に加算されます。"
  },
  {
    "chunkId": "chunk_gm_008a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_008",
    "startMs": 44000,
    "endMs": 47000,
    "speakerLabel": "SYSTEM",
    "text": "基本機能の確認は完了です。"
  },
  {
    "chunkId": "chunk_gm_008b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_008",
    "startMs": 47000,
    "endMs": 50000,
    "speakerLabel": "SYSTEM",
    "text": "未受信の通信が周辺に残存しています。探索を開始してください。",
    "importance": "critical",
    "fragmentRecovery": {
      "weight": 1.5,
      "lifetimeMultiplier": 1.35
    }
  },
  {
    "chunkId": "chunk_gm_009a",
    "transmissionId": "tx_good_morning",
    "lineId": "line_009",
    "startMs": 50000,
    "endMs": 52500,
    "speakerLabel": "SYSTEM",
    "text": "本プロトコルを終了します。"
  },
  {
    "chunkId": "chunk_gm_009b",
    "transmissionId": "tx_good_morning",
    "lineId": "line_009",
    "startMs": 52500,
    "endMs": 55000,
    "speakerLabel": "SYSTEM",
    "text": "……健闘を。"
  }
]
