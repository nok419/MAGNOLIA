    "transmissionId": "tx_where_are_you",
    "lineId": "line_005",
    "startMs": 28600,
    "endMs": 32100,
    "speakerLabel": "タクミ",
    "text": "お前もちゃんと食えよ。列長いけどサボんな。"
  },
  {
    "chunkId": "chunk_way_006a",
    "transmissionId": "tx_where_are_you",
    "lineId": "line_006",
    "startMs": 32100,
    "endMs": 35500,
    "speakerLabel": "タクミ",
