  {
    "chunkId": "chunk_way_002c",
    "transmissionId": "tx_where_are_you",
    "lineId": "line_002",
    "startMs": 9600,
    "endMs": 11500,
    "speakerLabel": "カナ",
    "text": "……夜、冷えるでしょう。"
  },
  {
    "chunkId": "chunk_way_003a",
    "transmissionId": "tx_where_are_you",
    "lineId": "line_003",
    "startMs": 11500,
    "endMs": 14500,
