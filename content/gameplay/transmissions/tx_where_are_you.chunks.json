    "transmissionId": "tx_where_are_you",
    "lineId": "line_008",
    "startMs": 51600,
    "endMs": 55100,
    "speakerLabel": "ミサキ",
    "text": "サトウさん、相変わらず声が大きくてすぐわかった。"
