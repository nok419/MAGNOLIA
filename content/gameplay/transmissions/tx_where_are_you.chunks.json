    "chunkId": "chunk_way_002b",
    "transmissionId": "tx_where_are_you",
    "lineId": "line_002",
    "startMs": 8000,
    "endMs": 9600,
    "speakerLabel": "カナ",
    "text": "そっちにも届いてるといいんだけど。"
