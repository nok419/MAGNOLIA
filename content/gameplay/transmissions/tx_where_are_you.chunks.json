    "transmissionId": "tx_where_are_you",
    "lineId": "line_006",
    "startMs": 35500,
    "endMs": 39800,
    "speakerLabel": "タクミ",
    "text": "あの漫画の続き、まだ読んでねえからな。帰ったら貸せよ。",
