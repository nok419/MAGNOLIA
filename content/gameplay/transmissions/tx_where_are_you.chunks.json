  {
    "chunkId": "chunk_way_007a",
    "transmissionId": "tx_where_are_you",
    "lineId": "line_007",
    "startMs": 41300,
    "endMs": 44700,
    "speakerLabel": "ミサキ",
    "text": "ハルカ、ミサキです。"
